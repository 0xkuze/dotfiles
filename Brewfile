# Brewfile — packages managed by Homebrew.
# Re-sync this Mac with the list:    brew bundle --file=./Brewfile
# Add a tool by appending one line below, then re-run the command above.

# ── CLI: modern stack ─────────────────────────────────────────────
brew "chezmoi"      # dotfile manager
brew "starship"     # cross-shell prompt
brew "eza"          # modern `ls`
brew "bat"          # modern `cat`
brew "fd"           # modern `find`
brew "ripgrep"      # fast `grep`
brew "fzf"          # fuzzy finder
brew "zoxide"       # smarter `cd`
brew "atuin"        # synced shell history
brew "jq"           # JSON processor
brew "gh"           # GitHub CLI
brew "lazygit"      # git TUI
brew "neovim"       # editor
brew "tmux"         # terminal multiplexer
brew "mise"         # runtime version manager (node, python, go, ...)

