# ~/.zprofile — runs once per login shell.
# Keep this file tiny: only environment setup that must precede ~/.zshrc.

# Homebrew on PATH (Apple Silicon → Intel fallback)
if   [[ -x /opt/homebrew/bin/brew ]]; then eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew    ]]; then eval "$(/usr/local/bin/brew shellenv)"
fi

# mise shims — make language runtimes visible to non-interactive shells
# (Zed, DataGrip, cron, scripts). Interactive activation lives in ~/.zshrc.
command -v mise >/dev/null && eval "$(mise activate zsh --shims)"
